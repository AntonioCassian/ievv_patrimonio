// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum Role {
  ADMINISTRADOR
  PASTOR
  SUPERVISOR
  LIDER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  DISPOSED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  CANCELLED
}

enum OperationType {
  USUFRUTO
  DOACAO
}

enum OperationStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum UsufructHistoryType {
  CREATED
  RENEWED
}

enum AssetCategory {
  UTENSILIO
  COZINHA
  ACESSORIO
  MOVEIS
  DIVERSOS
  DECORACAO
  SOM
  ELETRODOMESTICO
  INFORMATICA
  ILUMINACAO
  LIVROS
  HIDRAULICOS
  FOTOGRAFIA
}

enum NotificationType {
  EMPRESTIMO
  DEVOLUCAO
  USUFRUTO
  DOACAO
  PATRIMONIO
}

// =========================
// USER
// =========================

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  phone             String?
  password          String?
  role              Role
  status            UserStatus @default(ACTIVE)
  temporaryPassword Boolean    @default(false)
  lastLoginAt       DateTime?

  // =========================
  // DEPARTMENT
  // =========================

  departmentId String?
  department   Department? @relation("DepartmentUsers", fields: [departmentId], references: [id])

  ledDepartments     Department[] @relation("DepartmentLeader")
  createdDepartments Department[] @relation("DepartmentCreator")

  // =========================
  // PASSWORD RESET
  // =========================

  passwordResets PasswordReset[]

  // =========================
  // ASSETS
  // =========================

  responsibleAssets Asset[] @relation("AssetResponsible")
  createdAssets     Asset[] @relation("AssetCreator")

  // =========================
  // LOANS
  // =========================

  loansAsResponsible Loan[] @relation("ResponsibleLoans")
  createdLoans       Loan[] @relation("LoanCreator")
  returnedLoans      Loan[] @relation("LoanReturner")

  // =========================
  // ASSET OPERATIONS
  // =========================

  operationResponsible AssetOperation[] @relation("OperationResponsible")
  createdOperations    AssetOperation[] @relation("OperationCreator")

  // =========================
  // USUFRUCT HISTORY
  // =========================

  usufructHistoryCreated UsufructHistory[] @relation("UsufructHistoryCreator")

  // =========================
  // NOTIFICATIONS
  // =========================

  notifications Notification[] @relation("UserNotifications")

  notificationSettings NotificationSettings?

  // =========================
  // TIMESTAMPS
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

// =========================
// DEPARTMENT
// =========================

model Department {
  id     String           @id @default(cuid())
  name   String           @unique
  status DepartmentStatus @default(ACTIVE)

  // =========================
  // LEADER
  // =========================

  leaderId String
  leader   User   @relation("DepartmentLeader", fields: [leaderId], references: [id])

  // =========================
  // USERS / ASSETS
  // =========================

  users  User[]  @relation("DepartmentUsers")
  assets Asset[] @relation("DepartmentAssets")

  // =========================
  // CREATOR
  // =========================

  createdById String?
  createdBy   User?   @relation("DepartmentCreator", fields: [createdById], references: [id])

  // =========================
  // TIMESTAMPS
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaderId])
  @@index([createdById])
}

// =========================
// PASSWORD RESET
// =========================

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// =========================
// ASSET
// =========================

model Asset {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  description     String?
  category        AssetCategory
  type            String
  value           Decimal?      @db.Decimal(12, 2)
  acquisitionDate DateTime?
  imageUrl        String?
  status          AssetStatus   @default(AVAILABLE)

  // =========================
  // QUANTITY
  // =========================

  quantity          Int @default(1)
  quantityAvailable Int @default(1)

  // =========================
  // DEPARTMENT
  // =========================

  departmentId String
  department   Department @relation("DepartmentAssets", fields: [departmentId], references: [id])

  // =========================
  // RESPONSIBLE
  // =========================

  responsibleId String?
  responsible   User?   @relation("AssetResponsible", fields: [responsibleId], references: [id])

  // =========================
  // CREATOR
  // =========================

  createdById String
  createdBy   User   @relation("AssetCreator", fields: [createdById], references: [id])

  // =========================
  // LOANS
  // =========================

  loans Loan[] @relation("AssetLoans")

  // =========================
  // OPERATIONS
  // =========================

  operations AssetOperation[] @relation("AssetOperations")

  // =========================
  // TIMESTAMPS
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([responsibleId])
  @@index([createdById])
  @@index([status])
}

// =========================
// LOAN
// =========================

model Loan {
  id String @id @default(cuid())

  // =========================
  // ASSET
  // =========================

  assetId String
  asset   Asset  @relation("AssetLoans", fields: [assetId], references: [id])

  // =========================
  // RESPONSIBLE
  // =========================

  responsibleId String
  responsible   User   @relation("ResponsibleLoans", fields: [responsibleId], references: [id])

  // =========================
  // CREATOR
  // =========================

  createdById String
  createdBy   User   @relation("LoanCreator", fields: [createdById], references: [id])

  // =========================
  // LOAN DATA
  // =========================

  purpose            String
  withdrawalDate     DateTime
  expectedReturnDate DateTime

  // =========================
  // RETURN
  // =========================

  returnedAt DateTime?

  returnedById String?
  returnedBy   User?   @relation("LoanReturner", fields: [returnedById], references: [id])

  returnCondition String?
  returnNotes     String?

  // =========================
  // STATUS
  // =========================

  status LoanStatus @default(ACTIVE)

  // =========================
  // TIMESTAMPS
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([responsibleId])
  @@index([createdById])
  @@index([returnedById])
  @@index([status])
}

// =========================
// ASSET OPERATION
// =========================

model AssetOperation {
  id String @id @default(cuid())

  type OperationType

  status OperationStatus @default(ACTIVE)

  // =========================
  // ASSET
  // =========================

  assetId String
  asset   Asset  @relation("AssetOperations", fields: [assetId], references: [id])

  quantity Int

  operationDate DateTime
  observations  String?

  // =========================
  // USUFRUCT
  // =========================

  responsibleId String?
  responsible   User?   @relation("OperationResponsible", fields: [responsibleId], references: [id])

  startDate DateTime?
  endDate   DateTime?
  purpose   String?

  // =========================
  // DONATION
  // =========================

  donor        String?
  donationDate DateTime?
  document     String?

  // =========================
  // CREATOR
  // =========================

  createdById String
  createdBy   User   @relation("OperationCreator", fields: [createdById], references: [id])

  // =========================
  // HISTORY
  // =========================

  histories UsufructHistory[]

  // =========================
  // TIMESTAMPS
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([responsibleId])
  @@index([createdById])
  @@index([type])
  @@index([status])
}

// =========================
// USUFRUCT HISTORY
// =========================

model UsufructHistory {
  id String @id @default(cuid())

  operationId String
  operation   AssetOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  type UsufructHistoryType

  previousEndDate DateTime?
  newEndDate      DateTime?

  justification String?

  createdById String
  createdBy   User   @relation("UsufructHistoryCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([operationId])
  @@index([createdById])
}

// =========================
// CHURCH SETTINGS
// =========================

model ChurchSettings {
  id      String  @id @default(cuid())
  name    String
  address String?
  city    String?
  state   String?
  phone   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// NOTIFICATION
// =========================

model Notification {
  id      String           @id @default(cuid())
  title   String
  message String
  type    NotificationType
  isRead  Boolean          @default(false)

  userId String
  user   User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

// =========================
// NOTIFICATION SETTINGS
// =========================

model NotificationSettings {
  id String @id @default(cuid())

  // =========================
  // USER
  // =========================

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // =========================
  // NOTIFICATION TYPES
  // =========================

  notificacaoEmprestimo Boolean @default(true)
  notificacaoDevolucao  Boolean @default(true)
  notificacaoUsufruto   Boolean @default(true)
  notificacaoDoacao     Boolean @default(true)
  notificacaoPatrimonio Boolean @default(true)

  // =========================
  // TIMESTAMPS
  // =========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
